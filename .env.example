# Supabase (browser-side; anon/public key only — never a service_role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Live owner-dashboard probe (`npm run probe:live-owner`) — OPTIONAL owner creds.
# The probe authenticates as a real owner before running the exact live
# diagnostics, then prints the verdict. It uses only the anon key above and
# prints no tokens. Sign in with email/password, OR pass a valid session
# access token with PROBE_ACCESS_TOKEN. Never put a service_role key here.
# PROBE_OWNER_EMAIL=owner@example.com
# PROBE_OWNER_PASSWORD=owner-password
# PROBE_ACCESS_TOKEN=valid-session-access-token

# Nominatim identification (server-side) — OPTIONAL.
# The app ships with a working built-in identifier; set these only to
# override it. See https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_APP_IDENTIFIER=YourApp/1.0 (+mailto:you@example.com)
# NOMINATIM_REFERER=https://your-domain.example
# Optional: switch geocoding service without a code change
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
