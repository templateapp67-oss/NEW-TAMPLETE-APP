# Supabase (browser-side; anon/public key only — never a service_role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Nominatim identification (server-side) — OPTIONAL.
# The app ships with a working built-in identifier; set these only to
# override it. See https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_APP_IDENTIFIER=YourApp/1.0 (+mailto:you@example.com)
# NOMINATIM_REFERER=https://your-domain.example
# Optional: switch geocoding service without a code change
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
