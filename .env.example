# Supabase — the ONE browser configuration used by Vite and supabaseClient.ts.
#
# Local development:
#   copy this file to .env.local, replace both placeholders, restart `npm run dev`.
# Preview / production:
#   set the same two names in the deployment environment BEFORE the Vite build,
#   then redeploy. Vite embeds VITE_* values into the browser bundle at build time.
#
# Use only the project's public anon key (legacy JWT) or public publishable key.
# NEVER place a service_role key, sb_secret_* key, database password, access
# token, refresh token, or other private server credential in a VITE_* value.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Live owner-dashboard verification (`npm run probe:live-owner`) — OPTIONAL.
# These are operator-only probe inputs, not application configuration. Keep them
# only in an ignored local environment or secure CI secret store; never commit
# them and never expose them to the Vite/browser build.
# Sign in with an existing owner account:
# PROBE_OWNER_EMAIL=owner@example.com
# PROBE_OWNER_PASSWORD=owner-password
#
# The probe intentionally uses the browser-safe anon key above. It never uses a
# service_role key and never reads job_salon_members.

# Gemini — OPTIONAL SERVER-ONLY secret used by server.ts.
# Do not prefix it with VITE_; the browser must never receive it.
# GEMINI_API_KEY=server-only-key

# Nominatim identification (server-side) — OPTIONAL.
# The app ships with a working built-in identifier; set these only to override it.
# See https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_APP_IDENTIFIER=YourApp/1.0 (+mailto:you@example.com)
# NOMINATIM_REFERER=https://your-domain.example
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
