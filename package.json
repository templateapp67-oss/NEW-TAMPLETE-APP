{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:auth": "tsx scripts/test-auth-modal.mjs",
    "test:customization": "tsx scripts/test-website-customization.mjs",
    "test:owner": "tsx scripts/test-owner-profile.mjs",
    "test:theme-catalog": "tsx scripts/test-theme-catalog-ui.mjs",
    "test:service-saving": "tsx scripts/test-service-saving.mjs",
    "test:service-management": "tsx scripts/test-service-management-e2e.mjs",
    "test:service-security": "tsx scripts/test-service-security.mjs",
    "test:acceptance": "tsx scripts/test-phase-8.3-acceptance.mjs",
    "test:acceptance-ui": "tsx scripts/test-phase-8.3-ui.mjs",
    "test:phase-7.4-final": "npm run validate:migrations && npm run test:theme-catalog && npm run test:service-saving",
    "test:phase-8.1": "npm run validate:migrations && npm run test:theme-catalog && npm run test:service-saving && npm run test:service-management",
    "test:phase-8.2": "npm run validate:migrations && npm run test:theme-catalog && npm run test:service-saving && npm run test:service-management && npm run test:service-security",
    "test:phase-8.3": "npm run test:acceptance && npm run test:acceptance-ui",
    "test:phase-8": "npm run validate:migrations && npm run test:theme-catalog && npm run test:service-saving && npm run test:service-management && npm run test:service-security && npm run test:acceptance && npm run test:acceptance-ui",
    "test:phase-9.1": "npm run validate:migrations && tsx scripts/test-phase-9.1.mjs",
    "generate:theme-seed": "tsx scripts/generate-theme-seed.mts --write",
    "validate:migrations": "tsx scripts/generate-theme-seed.mts --check && tsx scripts/validate-migrations.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
